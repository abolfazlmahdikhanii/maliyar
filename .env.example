# Frontend (copy this file to .env.local)

# Convex deployment URL. Created automatically by `npx convex dev`.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------
# Backend secrets live in Convex, NOT in this file.
# Set them with:
#
#   npx convex env set ZAI_API_KEY your_key_here
#
# ZAI_API_KEY: Z.ai API key used by the AI chat (GLM-4.7-Flash)
# ---------------------------------------------------------------